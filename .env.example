# ==========================================
# HR Chomnan Full-Stack Environment Config
# ==========================================

# Database Settings
POSTGRES_DB=employee_attendance_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_to_a_strong_password_in_production
POSTGRES_PORT=5432

# Backend Security
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_123456
BACKEND_PORT=8080

# Frontend Settings
FRONTEND_PORT=80
# Leave VITE_API_BASE_URL empty if frontend and backend are accessed on the same domain/IP
# Or specify full URL (e.g. http://your-server-ip:8080/api or https://api.yourdomain.com/api)
VITE_API_BASE_URL=
