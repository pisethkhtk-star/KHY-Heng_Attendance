# Backend server IP / Hostname for Nginx reverse proxy (When backend is on a separate EC2 instance)
BACKEND_HOST=52.54.142.123

# Optional: Set full backend URL if frontend directly connects without Nginx proxy
# If not specified in production, defaults to relative '/api' (handled by Nginx reverse proxy)
VITE_API_BASE_URL=

# Port for local dev server
PORT=5173
